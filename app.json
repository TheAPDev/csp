{
  "expo": {
    "name": "WONDERKIN",
    "slug": "wonderkin",
    "scheme": "wonderkin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./src/assets/images/wonderkin-logo.png",
    "splash": {
      "backgroundColor": "#0B1026"
    },
    "assetBundlePatterns": ["**/*"],
    "updates": { "enabled": false },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wonderkin.app"
    },
    "android": {
      "package": "com.wonderkin.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1026"
      }
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-av",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WONDERKIN uses your rough area to pick which treasures appear nearby — never your exact location.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
